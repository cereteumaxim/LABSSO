index a03a33e..040b42b 100644
--- a/kernel/sysproc.c
+++ b/kernel/sysproc.c
@@ -6,6 +6,7 @@
 #include "spinlock.h"
 #include "proc.h"
 #include "vm.h"
+#include "sysinfo.h"
 
 uint64
 sys_exit(void)
@@ -120,3 +121,19 @@ sys_trace(void)
   myproc()->trace_mask = mask;
   return 0;
 }
+
+// sysinfo(struct sysinfo *): copy free memory and process count to user space
+uint64
+sys_sysinfo(void)
+{
+  uint64 addr;
+  struct sysinfo info;
+  struct proc *p = myproc();
+
+  argaddr(0, &addr);
+  info.freemem = kfreemem();
+  info.nproc = nproc_used();
+  if (copyout(p->pagetable, p->sz, addr, (char *)&info, sizeof(info)) < 0)
+    return -1;
+  return 0;
+}
diff --git a/user/sysinfo.c b/user/sysinfo.c
new file mode 100755
index 0000000..0e1095d
--- /dev/null
+++ b/user/sysinfo.c
@@ -0,0 +1,59 @@
+// sysinfo: show free memory and the number of processes, then change both
+// on purpose and show them again.
+#include "kernel/types.h"
+#include "kernel/sysinfo.h"
+#include "user/user.h"
+
+#define PAGE 4096
+
+static struct sysinfo
+show(char *when)
+{
+  struct sysinfo si;
+
+  if (sysinfo(&si) < 0) {
+    fprintf(2, "sysinfo: failed\n");
+    exit(1);
+  }
+  printf("%s free %ld bytes (%ld pages), %ld processes\n",
+         when, si.freemem, si.freemem / PAGE, si.nproc);
+  return si;
+}
+
+int
+main(void)
+{
+  struct sysinfo a, b;
+  int pid, fd[2];
+  char c;
+
+  a = show("at start:            ");
+
+  // 1. grow the heap by 10 pages: free memory must go down
+  if (sbrk(10 * PAGE) == SBRK_ERROR) {
+    fprintf(2, "sysinfo: sbrk failed\n");
+    exit(1);
+  }
+  memset(sbrk(0) - 10 * PAGE, 1, 10 * PAGE); // touch the pages
+  b = show("after sbrk(10 pages):");
+  printf("  memory used: %ld pages\n", (a.freemem - b.freemem) / PAGE);
+
+  // 2. a child that waits on a pipe: one more process
+  pipe(fd);
+  pid = fork();
+  if (pid == 0) {
+    close(fd[1]);
+    read(fd[0], &c, 1); // blocks until the parent closes its end
+    exit(0);
+  }
+  close(fd[0]);
+  show("with a child alive:  ");
+  close(fd[1]);
+  wait(0);
+  show("after wait:          ");
+
+  // 3. a bad pointer must be refused, not crash the kernel
+  if (sysinfo((struct sysinfo *)0xffffffffff) < 0)
+    printf("bad pointer: sysinfo returned -1\n");
+  exit(0);
+}
