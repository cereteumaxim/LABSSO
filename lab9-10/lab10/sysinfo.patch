new file mode 100755
index 0000000..53f30e4
--- /dev/null
+++ b/kernel/sysinfo.h
@@ -0,0 +1,5 @@
+// What the sysinfo system call fills in for the caller.
+struct sysinfo {
+  uint64 freemem; // free physical memory, in bytes
+  uint64 nproc;   // processes whose state is not UNUSED
+};
