     memset((char *)r, 5, PGSIZE); // fill with junk
   return (void *)r;
 }
+
+// Bytes of free physical memory: walk the free list, one page per entry.
+uint64
+kfreemem(void)
+{
+  struct run *r;
+  uint64 n = 0;
+
+  acquire(&kmem.lock);
+  for (r = kmem.freelist; r; r = r->next)
+    n++;
+  release(&kmem.lock);
+  return n * PGSIZE;
+}
diff --git a/kernel/proc.c b/kernel/proc.c
index ee8a92b..e526fc2 100644
--- a/kernel/proc.c
+++ b/kernel/proc.c
@@ -702,3 +702,19 @@ procdump(void)
     printk("\n");
   }
 }
+
+// Number of slots in the process table that are in use.
+uint64
+nproc_used(void)
+{
+  struct proc *p;
+  uint64 n = 0;
+
+  for (p = proc; p < &proc[NPROC]; p++) {
+    acquire(&p->lock);
+    if (p->state != UNUSED)
+      n++;
+    release(&p->lock);
+  }
+  return n;
+}
