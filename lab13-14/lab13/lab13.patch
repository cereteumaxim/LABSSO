diff --git a/user/mix.c b/user/mix.c
new file mode 100644
index 0000000..d933352
--- /dev/null
+++ b/user/mix.c
@@ -0,0 +1,33 @@
+// mix.c: two processes print five lines each, one letter per write().
+//   mix        no lock: the letters of the two processes can mix
+//   mix lock   semaphore 3 used as a lock: every line stays whole
+#include "kernel/types.h"
+#include "user/user.h"
+
+void
+lines(char *s, int uselock)
+{
+  for (int k = 0; k < 5; k++) {
+    if (uselock)
+      sem_down(3);                 // start of the critical section
+    for (char *p = s; *p; p++)
+      write(1, p, 1);              // one system call per letter
+    if (uselock)
+      sem_up(3);                   // end of the critical section
+  }
+}
+
+int
+main(int argc, char *argv[])
+{
+  int uselock = (argc > 1);
+
+  sem_init(3, 1);
+  if (fork() == 0) {
+    lines("bbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\n", uselock);
+    exit(0);
+  }
+  lines("AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\n", uselock);
+  wait(0);
+  exit(0);
+}
diff --git a/user/semtest.c b/user/semtest.c
new file mode 100644
index 0000000..1e03ed5
--- /dev/null
+++ b/user/semtest.c
@@ -0,0 +1,40 @@
+// semtest.c: two tests for the kernel semaphores (Lab 13).
+#include "kernel/types.h"
+#include "user/user.h"
+
+int
+main(void)
+{
+  // Test 1: order. Semaphore 0 starts at 0, so the child has to wait
+  // in sem_down until the parent calls sem_up.
+  sem_init(0, 0);
+  if (fork() == 0) {
+    sem_down(0);
+    printf("child: I ran after the parent\n");
+    exit(0);
+  }
+  pause(10);
+  printf("parent: done, I let the child go\n");
+  sem_up(0);
+  wait(0);
+
+  // Test 2: ping-pong. Semaphore 1 = ping may print, semaphore 2 = pong may print.
+  sem_init(1, 1);
+  sem_init(2, 0);
+  if (fork() == 0) {
+    for (int i = 1; i <= 3; i++) {
+      sem_down(2);
+      printf("   pong %d\n", i);
+      sem_up(1);
+    }
+    exit(0);
+  }
+  for (int i = 1; i <= 3; i++) {
+    sem_down(1);
+    printf("ping %d\n", i);
+    sem_up(2);
+  }
+  wait(0);
+  printf("semtest: OK\n");
+  exit(0);
+}
diff --git a/user/semtry.c b/user/semtry.c
new file mode 100644
index 0000000..2b978bd
--- /dev/null
+++ b/user/semtry.c
@@ -0,0 +1,15 @@
+// semtry.c: shows both answers of sem_trydown (optional part of Lab 13).
+#include "kernel/types.h"
+#include "user/user.h"
+
+int
+main(void)
+{
+  sem_init(4, 1);
+  printf("sem 4 = 1, sem_trydown -> %d\n", sem_trydown(4));   // takes the unit: 0
+  printf("sem 4 = 0, sem_trydown -> %d\n", sem_trydown(4));   // nothing left: -1 at once
+  sem_up(4);
+  printf("after sem_up, sem_trydown -> %d\n", sem_trydown(4)); // 0 again
+  printf("bad id 9, sem_trydown -> %d\n", sem_trydown(9));    // -1
+  exit(0);
+}
